10 REM *** HOROSCOPE FINDER ***
20 DIM A$(10)
30 PRINT "RETRO HOROSCOPE"
40 PRINT "---------------------------------"
50 PRINT "ENTER BIRTH MONTH (1-12): ";
60 INPUT M : REM M = MONTH
70 IF M < 1 OR M > 12 THEN GOTO 50
80 PRINT "ENTER BIRTH DAY (1-31): ";
90 INPUT D : REM D = DAY
100 IF D < 1 OR D > 31 THEN GOTO 80
110 REM --- LOGIC TO FIND SIGN NUMBER (S) ---
120 S = M
130 IF M = 1 AND D < 20 THEN S = 12
140 IF M = 2 AND D < 19 THEN S = 1
150 IF M = 3 AND D < 21 THEN S = 2
160 IF M = 4 AND D < 20 THEN S = 3
170 IF M = 5 AND D < 21 THEN S = 4
180 IF M = 6 AND D < 21 THEN S = 5
190 IF M = 7 AND D < 23 THEN S = 6
200 IF M = 8 AND D < 23 THEN S = 7
210 IF M = 9 AND D < 23 THEN S = 8
220 IF M = 10 AND D < 23 THEN S = 9
230 IF M = 11 AND D < 22 THEN S = 10
240 IF M = 12 AND D < 22 THEN S = 11
250 REM --- PRINT THE RELEVANT SIGN ---
260 PRINT "YOUR SIGN IS: ";
270 IF S = 1 THEN PRINT "AQUARIUS"
280 IF S = 2 THEN PRINT "PISCES"
290 IF S = 3 THEN PRINT "ARIES"
300 IF S = 4 THEN PRINT "TAURUS"
310 IF S = 5 THEN PRINT "GEMINI"
320 IF S = 6 THEN PRINT "CANCER"
330 IF S = 7 THEN PRINT "LEO"
340 IF S = 8 THEN PRINT "VIRGO"
350 IF S = 9 THEN PRINT "LIBRA"
360 IF S = 10 THEN PRINT "SCORPIO"
370 IF S = 11 THEN PRINT "SAGITTARIUS"
380 IF S = 12 THEN PRINT "CAPRICORN"
390 REM --- GENERATE A RANDOM RETRO FORTUNE ---
400 F = RND(4) + 1 : REM F = FORTUNE INDEX
410 PRINT "OUTLOOK: ";
420 IF F = 1 THEN PRINT "A GREAT DAY FOR RETRO COMPUTING!"
430 IF F = 2 THEN PRINT "AVOID CROWDS AND SYNTAX ERRORS."
440 IF F = 3 THEN PRINT "GOOD NEWS IS IN YOUR FUTURE CODE."
450 IF F = 4 THEN PRINT "RELOAD EMULATOR; LUCK IS LOW TODAY."
460 PRINT ""
470 PRINT "CHECK ANOTHER? (Y/N): ";
480 INPUT A$
490 IF A$ = "N" THEN END
500 GOTO 50
