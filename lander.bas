10 REM *** JUPITER LANDER (MINIFIED) ***
20 DIM A$(10)
30 PRINT "JUPITER LANDER"
40 PRINT "---------------------------------"
50 A = 1000 : REM A = ALTITUDE
60 V = 50   : REM V = VELOCITY
70 F = 150  : REM F = FUEL
80 G = 5    : REM G = GRAVITY
90 T = 0    : REM T = TIME
100 PRINT "SEC:";T;" ALT:";A;" VEL:";V;" FUEL:";F
110 IF A <= 0 THEN GOTO 250
120 PRINT "THRUST UNITS (0-10)? ";
130 INPUT B : REM B = BURN UNITS
140 IF B < 0 THEN B = 0
150 IF B > 10 THEN B = 10
160 IF B > F THEN B = F
170 F = F - B
180 REM P = PREVIOUS VELOCITY
200 P = V
210 V = V + G - B
220 A = A - (P + V) / 2
230 T = T + 1
240 GOTO 100
250 PRINT "---------------------------------"
260 PRINT "TOUCHDOWN AT ";T;" SECONDS."
270 PRINT "LANDING SPEED: ";V;" M/S."
290 IF V > 8 THEN GOTO 330
300 PRINT "EXCELLENT LANDING! WELCOME TO JUPITER."
310 GOTO 350
330 PRINT "CRASH! YOU OBLITERATED THE CRAFT."
340 PRINT "CREATING A NEW JUPITER CRATER..."
350 PRINT ""
360 PRINT "PLAY AGAIN? (Y/N): ";
370 INPUT A$
380 IF A$(1,1) = "Y" THEN GOTO 50
390 END

