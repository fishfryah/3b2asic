10 REM *** INTEGER BASIC GUESSING GAME ***
20 DIM A$(10)
30 PRINT "I AM THINKING OF A NUMBER BETWEEN 1 AND 100."
40 X = RND(100) + 1
50 C = 0
60 PRINT "ENTER YOUR GUESS: ";
70 INPUT G
80 C = C + 1
90 IF G = X THEN GOTO 140
100 IF G > X THEN PRINT "TOO HIGH! TRY AGAIN."
110 IF G < X THEN PRINT "TOO LOW! TRY AGAIN."
120 PRINT ""
130 GOTO 60
140 PRINT "CORRECT! YOU GOT IT IN ";C;" TRIES."
150 PRINT "PLAY AGAIN? (Y/N): ";
160 INPUT A$
170 IF A$(1,1) = "Y" THEN GOTO 30
180 END

