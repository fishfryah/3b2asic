10 REM *** SUB HUNT FOR INTEGER BASIC ***
20 DIM A$(10)
30 PRINT "SUBMARINE HUNT"
40 PRINT "---------------------------------"
50 X = RND(10) + 1 : REM X = SUB HORIZONTAL (1-10)
60 Y = RND(10) + 1 : REM Y = SUB DEPTH (1-10)
70 T = 0           : REM T = TURN COUNT
80 T = T + 1
90 PRINT "TURN ";T
100 PRINT "YOUR POSITION (1-10)? ";
110 INPUT P         : REM P = PLAYER X POSITION
120 IF P < 1 OR P > 10 THEN GOTO 100
130 PRINT "DROP DEPTH (1-10)? ";
140 INPUT D         : REM D = CHARGE EXPLOSION DEPTH
150 IF D < 1 OR D > 10 THEN GOTO 130
160 PRINT "BOOM! ";
170 IF P = X AND D = Y THEN GOTO 270
180 REM --- GIVE HOT/COLD SONAR HINTS ---
190 IF P < X THEN PRINT "SUB IS RIGHT. ";
200 IF P > X THEN PRINT "SUB IS LEFT. ";
210 IF D < Y THEN PRINT "SUB IS DEEPER."
220 IF D > Y THEN PRINT "SUB IS SHALLOWER."
230 PRINT ""
240 IF T < 6 THEN GOTO 80
250 PRINT "OUT OF AMMO! THE SUB ESCAPED."
260 GOTO 290
270 PRINT "DIRECT HIT!"
280 PRINT "YOU SANK THE SUB IN ";T;" TURNS."
290 PRINT ""
300 PRINT "PLAY AGAIN? (Y/N): ";
310 INPUT A$
320 IF A$(1,1) = "Y" THEN GOTO 50
330 END
