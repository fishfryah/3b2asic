10 REM INFINITE ASCII MAZE GENERATOR
20 RANDOMIZE
30 REM CHOOSE A RANDOM BINARY INTEGER: 0 OR 1
40 M = INT(RND(4))
50 REM CHOOSE CHARACTER BASED ON VALUE OF M
60 IF M = 0 THEN PRINT "/";
65 IF M = 2 THEN PRINT "|";
70 IF M = 1 THEN PRINT "\";
75 IF M = 3 THEN PRINT "_";
80 REM REPEAT INFINITELY TO FILL THE SCREEN
90 GOTO 10
